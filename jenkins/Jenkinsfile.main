pipeline {
    // NOTE: this job calls the workflow API on 127.0.0.1:8001, so it must run on
    // the host where `uvicorn workflow.api:app` runs. Pin it with a label
    // (e.g. agent { label 'false-alert-api' }) or set WORKFLOW_API_URL.
    agent any

    options {
        timeout(time: 15, unit: 'MINUTES')
    }

    parameters {
        string(name: 'INSTANCE_ID', defaultValue: '', description: 'Alert instance id')
        string(name: 'EVENT_ID', defaultValue: '', description: 'Alert event id')
        string(name: 'DEVICE_ID', defaultValue: '', description: 'Network device id')
        string(name: 'DEVICE_NAME', defaultValue: '', description: 'Network device name')
        string(name: 'SEVERITY', defaultValue: '', description: 'Alert severity')
        string(name: 'CATEGORY', defaultValue: '', description: 'Alert category')
        string(name: 'STATUS', defaultValue: '', description: 'Alert status')
        string(name: 'RAW_TIMESTAMP', defaultValue: '', description: 'Alert timestamp')
        string(name: 'CORRELATION_ID', defaultValue: '', description: 'Alert correlation id')
        string(name: 'SOURCE', defaultValue: '', description: 'Alert source')
        string(name: 'ISSUE_NAME', defaultValue: '', description: 'Alert issue name')
        string(name: 'ISSUE_DETAILS', defaultValue: '', description: 'Alert details')
        string(name: 'ISSUE_ID', defaultValue: '', description: 'DNAC Assurance issueId')
        string(name: 'RECEIVED_AT', defaultValue: '', description: 'Webhook receive time (ISO-8601)')
    }

    environment {
        PYTHONUNBUFFERED = '1'
        WORKFLOW_API_URL = 'http://127.0.0.1:8001/api/v1/invoke'
        // Jenkins "Secret text" credential holding the same value as WORKFLOW_API_TOKEN on the API host.
        WORKFLOW_API_TOKEN = credentials('false-alert-workflow-api-token')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Execute Main Agentic Workflow') {
            steps {
                // SECURITY: single-quoted Groovy string => no Groovy interpolation.
                // Alert fields reach Python only through environment variables
                // (Jenkins exposes build parameters as env vars), never through
                // the shell command line, so quotes/backticks/$() in alert text
                // cannot execute commands.
                sh '''
python3 - <<'PY'
import json, os, sys, urllib.request, urllib.error

keys = ["INSTANCE_ID", "EVENT_ID", "DEVICE_ID", "DEVICE_NAME", "SEVERITY", "CATEGORY", "STATUS",
        "RAW_TIMESTAMP", "CORRELATION_ID", "SOURCE", "ISSUE_NAME", "ISSUE_DETAILS",
        "ISSUE_ID", "RECEIVED_AT"]
payload = {k.lower(): (os.environ.get(k) or None) for k in keys}

req = urllib.request.Request(
    os.environ["WORKFLOW_API_URL"],
    data=json.dumps(payload).encode("utf-8"),
    headers={"Content-Type": "application/json", "X-API-Token": os.environ.get("WORKFLOW_API_TOKEN", "")},
)
try:
    with urllib.request.urlopen(req, timeout=600) as resp:
        body = resp.read()
except urllib.error.HTTPError as e:
    body = e.read()
    print(f"HTTP Error {e.code}: {body.decode('utf-8', errors='ignore')}", file=sys.stderr)
except Exception as e:
    body = json.dumps({"overall_status": "failed", "runtime_error": str(e)}).encode()
    print(f"Workflow API call failed: {e}", file=sys.stderr)

with open("status.json", "wb") as f:
    f.write(body)
PY

python3 - <<'PY'
import json, sys
try:
    with open("status.json") as f:
        data = json.load(f)
    s = data.get("overall_status", "unknown")
    print(f"overall_status={s}")
    codes = {"success": 0, "partial_failure": 2, "failed": 1, "unknown": 1, "config_error": 3}
    sys.exit(codes.get(s, 1))
except Exception as e:
    print(f"Could not read status.json: {e}", file=sys.stderr)
    sys.exit(1)
PY
'''
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'status.json, run.log', allowEmptyArchive: true
        }
    }
}
