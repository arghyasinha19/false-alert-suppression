# Copy to .env (never commit .env). Real environment variables override .env.

# ---- DNAC ----
DNAC_USERNAME=
DNAC_PASSWORD=
# Corporate CA bundle for DNAC TLS verification (overrides dnac.verify_ssl)
DNAC_CA_BUNDLE=

# ---- Webhook ingestion service (app/main.py, port 8000) ----
# Shared secret DNAC sends in the X-Webhook-Token header. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Re-register the DNAC subscription after setting it (POST /api/v1/subscriptions/register).
WEBHOOK_AUTH_TOKEN=
# Admin token for /api/v1/subscriptions* (header X-Admin-Token)
INGEST_ADMIN_TOKEN=
# Local testing only - never in prod
ALLOW_UNAUTHENTICATED_WEBHOOK=false
# Optional override of rabbitmq.routing_key
RABBITMQ_ROUTING_KEY=
LOG_FULL_PAYLOADS=false

# ---- RabbitMQ (all components) ----
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# ---- Jenkins (consumers) ----
JENKINS_URL=
JENKINS_USERNAME=
JENKINS_TOKEN=
JENKINS_JOB_PATH=
JENKINS_DELAYED_JOB_PATH=
# true | false | /path/to/ca.pem
JENKINS_VERIFY_TLS=true
JENKINS_WAIT_FOR_BUILD=false

# ---- Workflow API (workflow/api.py, port 8001) ----
# Must match the Jenkins "Secret text" credential 'false-alert-workflow-api-token'
WORKFLOW_API_TOKEN=
# Local testing only: allows the test MockClassifier when the model is missing
ALLOW_MOCK_CLASSIFIER=false

# ---- ServiceNow ----
SNOW_INSTANCE_URL=
SNOW_USERNAME=
SNOW_PASSWORD=
SNOW_PUSH_ENABLED=yes
SNOW_VERIFY_TLS=true
SNOW_TIMEOUT_SECONDS=20
SNOW_REOPEN_WINDOW_DAYS=3
# Confirm these against the PROD instance (exact choice values / names)
SNOW_CMDB_CI=Network
SNOW_CONTACT_TYPE=Monitoring
SNOW_ASSIGNMENT_GROUP=Global - CITO Network Services - Dyson
SNOW_CATEGORY=Inciden_Infrastructure & Network
SNOW_SUBCATEGORY=IT Enabling
SNOW_SUBCATEGORY_2=Event
# Out-of-the-box incident state values
SNOW_RESOLVED_STATE=6
SNOW_CLOSED_STATE=7
SNOW_CANCELED_STATE=8
SNOW_REOPEN_STATE=1
# Map DNAC severity -> impact/urgency on new incidents
SNOW_SET_IMPACT_URGENCY=false

# ---- MongoDB ----
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=false_alert_suppression

# ---- Dashboard ----
DASHBOARD_CORS_ORIGINS=http://localhost:5173
DASHBOARD_ALLOW_SIMULATED=false
DNAC_SYNC_THROTTLE_SECONDS=3
CHAT_DNAC_ALLOWED_PREFIXES=/dna/intent/api/v1/,/dna/data/api/v1/
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_CA_BUNDLE=
SUPPRESS_CA_BUNDLE=false
